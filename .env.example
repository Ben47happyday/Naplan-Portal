# Copy this file to .env and fill in real values. .env is gitignored.

# Flask session signing key. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to "production" once deployed; leave unset for local dev.
FLASK_ENV=

# PostgreSQL connection string (database/config.py, backend/app.py).
# Format: postgresql://user:password@host:5432/dbname
# Most managed Postgres hosts (Render, Neon, Supabase, RDS) require TLS —
# append ?sslmode=require if your provider needs it.
# Local dev: point this at a local Postgres instance.
DATABASE_URL=
