# Copy this file to .env and fill in real values. .env is gitignored.

# Flask session signing key. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to "production" once deployed; leave unset for local dev.
FLASK_ENV=

# Only needed once the app is migrated to PostgreSQL (Phase 2).
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=
